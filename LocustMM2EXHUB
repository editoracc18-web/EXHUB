return function(loopCollectAFK)
    loopCollectAFK = loopCollectAFK == true

    local player = game.Players.LocalPlayer
    local char = player.Character or player.CharacterAdded:Wait()
    local pos = char:GetPivot()

    local UserInputService = game:GetService("UserInputService")
    local TweenService = game:GetService("TweenService")
    local isCancelled = false

local function createNotification(titleText, bodyText)
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "CustomNotifyGui"
    screenGui.ResetOnSpawn = false
    screenGui.Parent = player:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 280, 0, 65)
    frame.Position = UDim2.new(1, 30, 0, 20)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    frame.BorderSizePixel = 0
    frame.ClipsDescendants = true
    frame.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 60, 60)
    stroke.Thickness = 1.5
    stroke.Parent = frame

    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 150, 150))
    })
    gradient.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -20, 0, 25)
    title.Position = UDim2.new(0, 10, 0, 5)
    title.BackgroundTransparency = 1
    title.Text = titleText:upper()
    title.TextColor3 = Color3.fromRGB(255, 60, 60)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 13
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = frame

    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, -20, 0, 30)
    text.Position = UDim2.new(0, 10, 0, 28)
    text.BackgroundTransparency = 1
    text.Text = bodyText
    text.TextColor3 = Color3.fromRGB(230, 230, 230)
    text.Font = Enum.Font.Gotham
    text.TextSize = 11
    text.TextWrapped = true
    text.TextXAlignment = Enum.TextXAlignment.Left
    text.TextYAlignment = Enum.TextYAlignment.Top
    text.Parent = frame

    local progressBar = Instance.new("Frame")
    progressBar.Size = UDim2.new(1, 0, 0, 3)
    progressBar.Position = UDim2.new(0, 0, 1, -3)
    progressBar.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    progressBar.BorderSizePixel = 0
    progressBar.Parent = frame

    TweenService:Create(frame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, -300, 0, 20)
    }):Play()

    TweenService:Create(progressBar, TweenInfo.new(5, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 0, 0, 3)
    }):Play()

    task.delay(5, function()
        local closeTween = TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 30, 0, 20)
        })
        closeTween:Play()
        closeTween.Completed:Connect(function()
            screenGui:Destroy()
        end)
    end)
end

local mapNames = {"Map2", "Map1", "Map3", "Map4", "Map5", "Map6", "Map7", "Map8", "Map9", "Map10"}

local function getFolder()
    for _, mapName in ipairs(mapNames) do
        local map = workspace:FindFirstChild(mapName)
        if map and map:FindFirstChild("ActiveKeys") then
            return map.ActiveKeys
        end
    end
    return nil
end

local initialFolder = getFolder()
if initialFolder then
    createNotification("Teleport Active", "T to cancel. Change the script variable to loop collect.")
else
    if not loopCollectAFK then
        createNotification("Error", "No Map Currently active!")
    else
        createNotification("Teleport Active", "Waiting for map... T to cancel. Change the script variable to loop collect.")
    end
end

local cancelConnection
cancelConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.T then
        isCancelled = true
        cancelConnection:Disconnect()
    end
end)

local function setupESP(folder)
    if folder:GetAttribute("ESPMonitoringActive") then return end
    folder:SetAttribute("ESPMonitoringActive", true)
    
    local connections = {}
    
    local function addESP(instance)
        if not instance:IsA("BasePart") and not instance:IsA("Model") then return end
        if instance:FindFirstChild("KeyESP") then return end
        
        local highlight = Instance.new("Highlight")
        highlight.Name = "KeyESP"
        highlight.FillColor = Color3.fromRGB(255, 0, 0)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.5
        highlight.Adornee = instance
        highlight.Parent = instance
    end
    
    for _, child in ipairs(folder:GetChildren()) do
        addESP(child)
    end
    
    local childAddedConn = folder.ChildAdded:Connect(function(child)
        addESP(child)
    end)
    table.insert(connections, childAddedConn)
    
    local ancestryConn
    ancestryConn = folder.AncestryChanged:Connect(function(_, parent)
        if not parent or not folder:IsDescendantOf(workspace) then
            for _, conn in ipairs(connections) do
                if conn.Connected then conn:Disconnect() end
            end
            ancestryConn:Disconnect()
        end
    end)
end

local function processFolder(folder)
    setupESP(folder)
    
    for i, v in ipairs(folder:GetChildren()) do
        if isCancelled or not folder:IsDescendantOf(workspace) then break end
        
        if v:IsA("BasePart") or v:IsA("Model") then
            local targetCFrame = v:GetPivot()
            local totalWaitTime = 0.6
            local shakeInterval = 0.05
            local elapsed = 0
            
            while elapsed < totalWaitTime do
                if isCancelled or not v.Parent or not folder:IsDescendantOf(workspace) then break end
                
                local sidewaysOffset = math.random(-50, 50) / 10 
                char:PivotTo(targetCFrame * CFrame.new(sidewaysOffset, 0, 0))
                
                task.wait(shakeInterval)
                elapsed = elapsed + shakeInterval
            end
        end
    end
end

repeat
    local folder = getFolder()
    if folder then
        processFolder(folder)
        if not loopCollectAFK then break end
    else
        if not loopCollectAFK then break end
        task.wait(1)
    end
until isCancelled

if cancelConnection.Connected then
    cancelConnection:Disconnect()
end

char:PivotTo(pos)
end
